# =========================
# Java, Maven & Spring Boot
# =========================
target/
build/
out/

# Allow nested target/build directories in src
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
*.class
*.log

# Local / Private Configuration
application-local.properties
local.properties
.env

# Application Private Data
private-invoices/
data/

# Maven Wrapper
.mvn/
!/.mvn/wrapper/maven-wrapper.jar

# JVM Crash Logs
hs_err_pid*
replay_pid*

# BlueJ & Mobile Tools
*.ctxt
.mtj.tmp/


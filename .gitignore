# =========================
# Java, Maven & Spring Boot
# =========================
target/
build/
out/

# Allow nested target/build directories in src (from Initializr)
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
*.class
*.log
application-local.properties

# Maven Wrapper
.mvn/
!/.mvn/wrapper/maven-wrapper.jar

# JVM Crash Logs
hs_err_pid*
replay_pid*

# BlueJ & Mobile Tools
*.ctxt
.mtj.tmp/

# =========================
# IDEs & Code Editors
# =========================
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/

# Zed
.zed/

# Eclipse / STS / Microsoft Workbench
.project
.classpath
.settings/
.metadata/
.apt_generated
.factorypath
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Terminal Editors (Vim & Nano)
*~
*.swp
*.swo
.nano_history

# =========================
# Database Clients (DBeaver)
# =========================
.dbeaver/
Scripts/

# =========================
# MySQL Workbench
# =========================
*.mwb.bak

# =========================
# Operating Systems
# =========================
# Windows 11
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux (Nobara)
.directory
.Trash-*

# =========================
# API Testing Tools
# =========================
*.http
*.rest
*.postman_collection.json
*.postman_environment.json
